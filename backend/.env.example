# === IBMCP FastAPI 环境变量示例 ===
APP_NAME=IBMCP
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production

# PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=ibmcp
PG_PASSWORD=ibmcp
PG_DATABASE=ibmcp
PG_POOL_MIN=5
PG_POOL_MAX=20

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Collector 扩展（Windows 开发用 stub）
COLLECTOR_BACKEND=stub
