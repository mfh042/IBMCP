[Unit]
Description=IBMCP FastAPI API + Collector Extension
After=network.target docker.service nginx.service

[Service]
Type=simple
User=meng
WorkingDirectory=/home/meng/ibmcp/backend
EnvironmentFile=/home/meng/ibmcp/backend/.env
ExecStart=/home/meng/ibmcp/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=3
LimitNOFILE=65536
LimitNPROC=8192

[Install]
WantedBy=multi-user.target